# Pooled connection for application queries.
DATABASE_URL=postgresql://ROLE:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/craftmish?sslmode=require

# Direct connection for database migrations.
DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@ep-example.eu-central-1.aws.neon.tech/craftmish?sslmode=require

# Branch-specific Neon Managed Auth URL.
NEON_AUTH_BASE_URL=https://example.neon.tech/craftmish/auth

# Generate a separate random secret for the application.
NEON_AUTH_COOKIE_SECRET=replace-with-a-unique-random-secret